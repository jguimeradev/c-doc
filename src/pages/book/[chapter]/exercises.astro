---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import DocLayout from '../../../layouts/DocLayout.astro';
import { bookSection, chapterLabel, chapterUrl, getBook, projectsSection, url } from '../../../data/nav';

export async function getStaticPaths() {
  const book = await getBook();
  const exercises = await getCollection('exercises');
  return exercises.map((ex) => {
    const chapter = book.find((c) => c.id === ex.data.chapter);
    if (!chapter) throw new Error(`exercises for unknown chapter ${ex.data.chapter}`);
    return { params: { chapter: chapter.id }, props: { ex, chapter } };
  });
}

const { ex, chapter } = Astro.props as {
  ex: CollectionEntry<'exercises'>;
  chapter: CollectionEntry<'book'>;
};
const { Content, headings } = await render(ex);
const list = headings.filter((h) => h.depth === 2);
---

<DocLayout
  title={`Exercises: ${chapter.data.title} - The C Book`}
  location={`Exercises ${chapter.data.number}`}
  locationHref={url(`book/${chapter.id}/exercises/`)}
  sections={[
    { title: 'Exercises', links: list.map((h) => ({ label: h.text.replace(/ (easy|medium|hard)$/, ''), href: `#${h.slug}` })) },
    await bookSection(chapter.id),
    await projectsSection(),
  ]}
>
  <div class="main-heading">
    <h1>Exercises <a href={chapterUrl(chapter.id)}>{chapterLabel(chapter)}</a></h1>
    <span class="out-of-band">{list.length} exercises · {ex.data.summary}</span>
  </div>

  <div class="docblock book-text exercises">
    <Content />
  </div>

  <nav class="chapter-nav" aria-label="Chapter navigation">
    <a class="prev" href={chapterUrl(chapter.id)}>← Back to {chapterLabel(chapter)}</a>
    <a class="next" href={url('projects/')}>Projects →</a>
  </nav>
</DocLayout>
